{
  "rule_pack_id": "hu_magasepitesi_tetelrend",
  "name": "Building sectoral item order (magasépítési ágazati tételrend)",
  "name_hu": "Egységes magasépítési ágazati tételrend",
  "standard": "tetelrend",
  "jurisdiction": "HU",
  "applies_to": [
    "projects",
    "boq",
    "tendering",
    "validation"
  ],
  "review_status": "Derived from Hungarian workbooks in production use. The structure below states what those files state.",
  "description": "The item order Hungarian building bills are written against. A bill is one workbook per chapter plus two summary sheets: a chapter summary that totals each sub-chapter, and a cover summary that totals the seventeen chapters, adds the contingency and then VAT. Every line carries a code, a quantity, a unit, a material unit price and a fee unit price.",
  "code_format": {
    "shape": "MA-CC[-SSS]*",
    "segments": 9,
    "separator": "-",
    "segment_1": "sector, MA for building works (magasépítési munkák)",
    "segment_2": "chapter (fejezet), two digits, 01 to 17",
    "segment_3": "sub-chapter (alfejezet), two or three digits; 99 and 199 are the chapter's EGYÉB catch-all",
    "segments_4_to_9": "further levels, two or three digits, used as deep as the bill needs",
    "examples": [
      "MA-01",
      "MA-01-11",
      "MA-01-11-01",
      "MA-09-95-01-02"
    ],
    "regex": "^MA-(0[1-9]|1[0-7])(?:-\\d{2,3}){0,7}$"
  },
