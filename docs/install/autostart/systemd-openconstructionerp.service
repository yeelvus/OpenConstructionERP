[Unit]
Description=OpenConstructionERP - open-source construction cost estimation
After=network.target

[Service]
Type=simple
User=openconstructionerp
Group=openconstructionerp
WorkingDirectory=/home/openconstructionerp

# Path to the venv that has `pip install openconstructionerp` in it.
# Replace with your install location.
ExecStart=/home/openconstructionerp/.venv/bin/openconstructionerp serve --host 0.0.0.0 --port 8000

# Environment overrides - uncomment what you need.
# Environment=SEED_DEMO=false
# Environment=DATABASE_URL=postgresql+asyncpg://oe:CHANGE_ME@localhost:5432/openestimate
# Environment=ALLOWED_ORIGINS=https://erp.example.com
# Environment=OE_OLLAMA_URL=http://localhost:11434/v1/chat/completions
#
# The semantic search encoder is roughly 500 MB and is NOT downloaded on a
# server by default. It only becomes worth its disk on a box with the memory
# to load it, so a small VPS is better off without it, and everything works
# without it: semantic search says so out loud and lexical search answers.
# Uncomment to switch it off outright, which also refuses the tick offered in
# the setup wizard. Set it to 1 instead to have the server fetch it at boot.
# Environment=OE_DOWNLOAD_EMBEDDING_MODEL=0

# Restart policy
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# The data directory keeps its historical name ~/.openestimate on every install.
ReadWritePaths=/home/openconstructionerp/.openestimate
PrivateTmp=true
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

# Log to journald (view with `journalctl -u openconstructionerp -f`)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
